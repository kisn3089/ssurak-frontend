{
  "extends": "@ssurak/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@utils/*": ["./utils/*"],
      "@ssurak/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mts",
    "vitest.config.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/api/src/schemas/model/menu-form-payload.schema.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    ".next/cache",
    ".next/server",
    ".next/static",
    ".next/build"
  ],
  "watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "**/.next/dev",
      "**/.next/cache",
      "**/.turbo"
    ]
  }
}
